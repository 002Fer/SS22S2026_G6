# Copiar como .env y ajustar a la instancia local. No subir .env al repositorio.
# Docker Compose usa estos valores; si no existe .env, aplica los valores
# locales predeterminados definidos en docker-compose.yml.
MSSQL_SA_PASSWORD=Practica1_G6_2026!
SQLSERVER_PORT=1433

SQLSERVER_SERVER=localhost
SQLSERVER_DATABASE=VuelosDW
# Es opcional: el cargador detecta automaticamente Driver 18, Driver 17 o SQL Server.
# SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_CERT=yes
SQLSERVER_TIMEOUT=30

# Para autenticacion de SQL Server, descomentar ambas variables.
# Si se omiten, la carga usa autenticacion integrada de Windows.
# SQLSERVER_USER=usuario
# SQLSERVER_PASSWORD=clave

# Como alternativa puede definirse una cadena completa:
# SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=VuelosDW;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes;
